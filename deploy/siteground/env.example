# eMotion Evaluations — SiteGround production environment
# Copy to .env in the app folder and fill in the values from Site Tools.

APP_NAME="eMotion Evaluations"
APP_ENV=production
APP_KEY=                      # generated once by: php artisan key:generate --force  (BACK THIS UP)
APP_DEBUG=false
APP_TIMEZONE=Asia/Karachi
APP_URL=https://evaluations.example.com   # your HTTPS domain; webhooks are registered with this

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Site Tools → MySQL: create a database and a user with all privileges
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=xxxxxxxx_emotion
DB_USERNAME=xxxxxxxx_emotion
DB_PASSWORD=

# Shared hosting: no Redis. Everything runs on MySQL tables (sessions, cache, cache_locks, jobs).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
CACHE_PREFIX=emotion
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Site Tools → Email → Accounts: create e.g. no-reply@yourdomain and use the SMTP details shown there
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Typeform: the token is entered in Admin → Settings → Typeform, never here.
TYPEFORM_DEFAULT_BASE_URL=https://api.typeform.com
TYPEFORM_RATE_LIMIT_PER_SECOND=2
WEBHOOK_DELIVERY_RETENTION_DAYS=90

# Leave empty in production; create the admin with: php artisan app:create-super-admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
